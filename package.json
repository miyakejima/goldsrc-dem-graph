{
  "name": "goldsrc-dem-graph",
  "version": "1.0.0",
  "description": "Offline local graph tester for GoldSrc demos",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace @kz-rebuild/api run dev",
    "dev:web": "npm --workspace @kz-rebuild/web run dev",
    "build": "npm run --workspaces build",
    "typecheck": "npm run --workspaces typecheck",
    "test:parser": "npm --workspace @kz-rebuild/parser run test"
  },
  "keywords": [
    "goldsrc",
    "half-life",
    "counter-strike",
    "kreedz",
    "bhop",
    "demo-parser",
    "graph"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
